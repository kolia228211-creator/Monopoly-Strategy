{
  "manifest_version": 3,
  "name": "RichUp Помічник",
  "version": "0.4.0",
  "description": "Поради в реальному часі для richup.io: купівля, аукціон, обміни, будинки, шанси на перемогу.",
  "content_scripts": [
    {
      "matches": [
        "https://richup.io/*"
      ],
      "js": [
        "loader.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "helper.js"
      ],
      "matches": [
        "https://richup.io/*"
      ]
    }
  ],
  "icons": {
    "128": "icon128.png"
  }
}
